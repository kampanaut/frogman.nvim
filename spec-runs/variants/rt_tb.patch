 local M = {}
 
+-- RT bonus experiment (sandbox only): on arrivals that have no guard 2, drop the arriving buffer's plain
+-- ternary note when it already names the ternary the window will have after the arrival.
+function M.rt_arrival_check(triquetra, new, newT)
+	if newT and triquetra.displacement_ternary_map[new] == newT then
+		triquetra.displacement_ternary_map[new] = nil
+		vim.notify("RT-bonus: dropped a plain ternary note equal to the ternary kept on arrival", vim.log.levels.WARN)
+	end
+end
