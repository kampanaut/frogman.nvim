@@ -46,3 +46,51 @@
 		navigationSM:to(navigationSM:state(), {}, states.mode.WINENTER)
 	end
 })
+
+-- WV (sandbox only), decided and unbuilt (A12, T175): jumping to another window cancels an active cycle.
+-- The cycling window goes back to its start, navigation goes back to normal, history is attached, nothing is recorded.
+-- Runs synchronously in WinEnter, after navigation's own WinEnter work (the walks never give the event loop a turn,
+-- so a scheduled cancel would never run there).
+local wv_cycling_window = nil
+navigationSM:on(states.NORMAL, states.CYCLING, "wv_note_cycling_window", function(context)
+	wv_cycling_window = (context.window and context.window.current_crux) or vim.api.nvim_get_current_win()
+end, 0.5, true, states.mode.CYCLE)
+
+local function wv_nm(h)
+	if h == nil then return "-" end
+	local n = _G.NAME and _G.NAME(h) or h:sub(1, 6)
+	return (n:gsub("%.txt", ""))
+end
+
+vim.api.nvim_create_autocmd("WinEnter", {
+	callback = function(_)
+		if navigationSM:state() ~= states.CYCLING then return end
+		local cw = vim.api.nvim_get_current_win()
+		local cyc = wv_cycling_window
+		if cyc == nil or cyc == cw then return end
+		-- 1. The cycling window back on its start while history is still detached, so the BufEnter this causes records nothing.
+		local origin = history.get_cycling_origins(cyc)
+		local start = origin and origin.current_slot
+		if start and vim.api.nvim_win_is_valid(cyc) then
+			local ob = history.get_buffer_from_hash(start)
+			if ob and vim.api.nvim_win_get_buf(cyc) ~= ob then vim.api.nvim_win_set_buf(cyc, ob) end
+			local t = require('cavediver.domains.window.data').crux[cyc]
+			if t then t.current_slot = start end
+		end
+		-- 2. Navigation back with no mode. WV-land (the other reading): history attaches as an ordinary entry into the
+		-- window you landed in, recording its buffer (UPDATE mode). Its reconcile runs on that window, whose current
+		-- slot is already that buffer, so no slot moves.
+		navigationSM:to(states.NORMAL)
+		local all_wr = require('cavediver.domains.window.routines') -- ALL: no Q9 pick note on the cancel's attach
+		all_wr.all_in_cancel = true
+		local all_ok, all_err = pcall(function()
+			history.sm:to(history.states.ATTACHED, { buf = vim.api.nvim_get_current_buf() }, history.states.mode.UPDATE)
+		end)
+		all_wr.all_in_cancel = false
+		if not all_ok then error(all_err, 0) end
+		local ui = require('cavediver.domains.ui')
+		ui.sm.loop:to(ui.states.LOOP.SELF)
+		wv_cycling_window = nil
+		vim.notify("WV-cancel: cycle cancelled, start " .. wv_nm(start), vim.log.levels.DEBUG)
+	end,
+})
