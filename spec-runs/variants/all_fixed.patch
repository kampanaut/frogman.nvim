 local M = {}
 
+-- RT (sandbox only): the notes written before every swap onto the secondary:
+-- <M-f>, its <M-;><M-f> fallback, and plain navigation onto the secondary (D8).
+local RT_MODE = "c3kg"
+local RT_OWN_SLOT = true
+-- KT (sandbox only): "Keep the older one" for the ternary memory, on every arrival that skips the stale-note
+-- check in navigation (hooks.lua, displacement_mangement). N arrives, A is left, T0 is the ternary before the
+-- arrival, T1 the ternary after it. When N's plain ternary note names T1, it is rewritten, after the arrival's
+-- own writes (the order navigation uses):
+--   T1 is A and N was the ternary -> dtm[A], the pre-jump stored ternary      (navigation's first case)
+--   T1 is A and N was not         -> T0, the pre-jump ternary                 (navigation's second case)
+--   T1 is T0 (the ternary stays)  -> "literal": T0 again (the second case as worded: no change)
+--                                    "kept":    dtm[T0], the kept ternary's own plain note
+-- KT_MODE "drop" drops the note on every one of these arrivals instead (the same-base comparison for dropping).
+local KT_MODE = "kept"
+local function kt_nm(h)
+	if h == nil then return "-" end
+	local n = _G.NAME and _G.NAME(h) or h:sub(1, 6)
+	return (n:gsub("%.txt", ""))
+end
+function M.kt_ter_rewrite(triquetra, kind, N, A, T0, T1)
+	local dtm = triquetra.displacement_ternary_map
+	if N == nil or T1 == nil or dtm[N] ~= T1 then return end
+	local new, case
+	if KT_MODE == "drop" then
+		new, case = nil, "drop"
+	elseif T1 == A then
+		if N == T0 then new, case = dtm[A], "c1" else new, case = T0, "c2" end
+	elseif KT_MODE == "literal" then
+		new, case = T0, "c2="
+	else
+		new, case = dtm[T0], "kept"
+	end
+	dtm[N] = new
+	vim.notify(string.format("KT-t %s %s %s>%s => %s", kind, case, kt_nm(N), kt_nm(T1), kt_nm(new)), vim.log.levels.DEBUG)
+end
+
+-- RT: drop the current buffer's plain secondary note when it names the window's secondary.
+-- KT: "Keep the older one" for the secondary memory on the other arrivals: rewrite x's stale plain note to the
+-- older partner when one is known (x's swap note, when it differs from the secondary), else drop it.
+-- site: where it ran; s0: the secondary slot's occupant before this event (logged as a candidate only).
+function M.rt_sec_check(triquetra, x, s, site, s0)
+	local dsm = triquetra.displacement_secondary_map
+	if x and s and dsm[x] == s then
+		local older = dsm[x .. "-swap"]
+		local out
+		if older ~= nil and older ~= s and older ~= x then dsm[x] = older; out = "rw" else dsm[x] = nil; out = "drop" end
+		vim.notify(string.format("KT-s %s %s %s>%s => %s swap=%s prev=%s", site or "?", out, kt_nm(x), kt_nm(s),
+			kt_nm(dsm[x]), kt_nm(older), kt_nm(s0)), vim.log.levels.DEBUG)
+	end
+end
+
+-- EX (sandbox only): the stale-note check where a slot changes under the current buffer x without a buffer
+-- becoming current (the restores, graduation, the history fill), and after a cleanup pass that moved a slot.
+-- Ternary map: when x's plain note names the ternary, it becomes, by EX_MODE:
+--   "own"  : the new ternary's own plain note dtm[T]                                    (a)
+--   "left" : t_left, the buffer that just left the ternary (at <M-;><M-t>'s exchange, the new secondary)  (b)
+--   "drop" : nothing                                                                    (c)
+-- A result naming x itself or T is dropped instead ("guard"). mode_override forces a rule (cleanup arrivals use
+-- "own", the decided rule where the ternary stays put).
+-- Secondary map: the decided rule, rt_sec_check (x's swap note when older, else dropped), in every mode.
+local EX_MODE = "own"
+function M.ex_slot_check(triquetra, site, t_left, s_left, mode_override)
+	local x = triquetra.current_slot
+	if x == nil then return end
+	local dtm = triquetra.displacement_ternary_map
+	local T = triquetra.ternary_slot
+	if T ~= nil and dtm[x] == T then
+		local mode = mode_override or EX_MODE
+		local new
+		if mode == "own" then new = dtm[T] elseif mode == "left" then new = t_left else new = nil end
+		local out
+		if new ~= nil and (new == x or new == T) then out = "guard"; new = nil end
+		dtm[x] = new
+		out = out or ((new == nil) and "nothing" or ((new == triquetra.secondary_slot) and "secondary" or "outside"))
+		vim.notify(string.format("EX-t %s %s %s>%s => %s %s", site, mode, kt_nm(x), kt_nm(T), kt_nm(new), out), vim.log.levels.DEBUG)
+	end
+	M.rt_sec_check(triquetra, x, triquetra.secondary_slot, "ex-" .. site, s_left)
+end
+function M.rt_secondary_notes(triquetra)
+	local A, S, T = triquetra.current_slot, triquetra.secondary_slot, triquetra.ternary_slot
+	local dsm = triquetra.displacement_secondary_map
+	if RT_MODE == "base" then
+		dsm[A] = S
+	elseif RT_MODE == "c1" then -- two kinds: a swap note, like dtm's
+		dsm[A .. "-swap"] = S
+	elseif RT_MODE == "c2a" then -- skip the write on a pure toggle back
+		if dsm[S] ~= A then dsm[A] = S end
+	elseif RT_MODE == "c2b" then -- skip the write on a pure toggle back, and clear the partner's note
+		if dsm[S] == A then dsm[S] = nil else dsm[A] = S end
+	elseif RT_MODE == "c3k" then -- C3 kept in dsm: the swap note is the last partner; promote it on arrival when the partner changes
+		local old = dsm[S .. "-swap"]
+		dsm[A .. "-swap"] = S
+		if old ~= nil and old ~= A then dsm[S] = old end
+	elseif RT_MODE == "c1g" then -- C1 plus the secondary guard: S's plain note naming A is cleared
+		dsm[A .. "-swap"] = S
+		if dsm[S] == A then dsm[S] = nil end
+	elseif RT_MODE == "c3kg" then -- C3 kept in dsm, plus the secondary guard
+		local old = dsm[S .. "-swap"]
+		dsm[A .. "-swap"] = S
+		if old ~= nil and old ~= A then dsm[S] = old elseif dsm[S] == A then dsm[S] = nil end
+	elseif RT_MODE == "c3" then -- note only when the arriving buffer's partner changes
+		triquetra.rt_partner = triquetra.rt_partner or {}
+		local p = triquetra.rt_partner
+		p[A] = S
+		local old = p[S]
+		if old ~= nil and old ~= A then dsm[S] = old end
+	end
+	if T then
+		triquetra.displacement_ternary_map[A .. "-swap"] = T
+	end
+end
